{
  "name": "timu",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs --dev",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "node -e \"for (const f of ['', '-wal', '-shm']) require('fs').rmSync((process.env.TIMU_DB_PATH || 'data/timu.db') + f, { force: true })\"",
    "sync:local": "tsx scripts/sync-local.ts",
    "mcp": "tsx --conditions=react-server scripts/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
