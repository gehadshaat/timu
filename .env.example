# --- Database: a SQLite file, created and migrated on first run. Defaults to data/timu.db ---
TIMU_DB_PATH=

# --- Claude: files sessions into projects / teams / roles / goals, and triages them ---
# Timu runs the Claude CLI (`claude -p`) on your Claude login — no API key. Leave empty to use `claude` on PATH;
# set a full path if the server's PATH can't see it, or "off" to use the rules-based organiser only.
CLAUDE_CLI=

# --- Source: Claude Code cloud sessions (claude.ai/code) ---
# Several Claude accounts: Timu finds ~/.claude and every ~/.claude-* folder with a login (CLAUDE_CONFIG_DIR=… claude).
# Or list the folders yourself; the settings below apply to the first one.
CLAUDE_ACCOUNTS=
# Unofficial: Timu calls the same sessions endpoint the Claude Code CLI uses.
# Sign-in is automatic: Timu reads your Claude Code login (~/.claude/.credentials.json) on every sync.
# Optional: a specific OAuth access token (tried first, e.g. on macOS where the login is in the Keychain).
CLAUDE_SESSIONS_TOKEN=
# Optional: where Claude Code's credentials file lives, if not ~/.claude/.credentials.json.
CLAUDE_CREDENTIALS_PATH=
CLAUDE_SESSIONS_API_URL=https://api.anthropic.com/v1/sessions
CLAUDE_ORG_UUID=
# Routines (scheduled cloud agents and check-ins) use the same login plus your organisation id
# (CLAUDE_ORG_UUID, or the account Claude Code is signed in with). Override these only if they move.
CLAUDE_ROUTINES_API_URL=
CLAUDE_ROUTINES_BETA=

# --- Source: local Claude Code transcripts ---
# Defaults to ~/.claude/projects
CLAUDE_PROJECTS_DIR=

# --- Chrome extension / sync CLI → Timu ingest endpoint ---
# Any long random string. Paste the same value into the extension options.
TIMU_INGEST_TOKEN=

# --- MCP server (/api/mcp): lets Claude organise Timu. Any long random string; `npm run setup` makes one. ---
# Claude sends it as "Authorization: Bearer <token>". See README "Let Claude run Timu (MCP)".
TIMU_MCP_TOKEN=

# --- Optional: protect the UI with a password (recommended once you host it) ---
TIMU_PASSWORD=

# --- Triage: does a session genuinely need you? (cheap model, reads your triage memory in Settings) ---
# TypeSafe Jev is used when TYPESAFE_API_KEY is set; otherwise Claude Haiku 5.5 (through the Claude CLI); otherwise status only.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
# Force one: typesafe | claude | status
TIMU_TRIAGE_ENGINE=
